# Copie para .env e troque os valores. O .env nunca vai para o Git.
# Sem .env, o projeto roda com valores de desenvolvimento (só para uso local).

# IA generativa (opcional). Sem chave, o alerta é redigido pelo gerador determinístico.
ANTHROPIC_API_KEY=
ALERTACHEIA_MODELO_IA=claude-opus-5-5

# Segurança
ALERTACHEIA_JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
ALERTACHEIA_JWT_MINUTOS=60
ALERTACHEIA_OPERADOR=defesacivil
ALERTACHEIA_OPERADOR_SENHA=troque-esta-senha
# Segredo mestre das chaves dos sensores (cada estação recebe uma chave derivada)
ALERTACHEIA_CHAVE_SENSORES=troque-este-segredo
# Chave Fernet para cifrar telefones. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALERTACHEIA_CHAVE_DADOS=

# Rede
ALERTACHEIA_PORTA=8080
ALERTACHEIA_CORS=http://localhost:5173,http://127.0.0.1:5173
